{
  "name": "doku",
  "type": "module",
  "version": "0.1.6",
  "scripts": {
    "dev": "concurrently \"NODE_ENV=development bun run --watch server.ts\" \"bunx vite\"",
    "dev:playground": "concurrently \"NODE_ENV=development DOKU_PLAYGROUND=1 bun run --watch server.ts\" \"bunx vite\"",
    "build": "bunx vite build",
    "start": "bun run server.ts",
    "pack": "bun run build && bun run scripts/pack.ts",
    "build:npm": "bun run scripts/build-npm.ts",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:harness": "bun run test/harness/runner.ts"
  },
  "dependencies": {
    "@lezer/highlight": "^1.2.3",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "^5.1.4",
    "beautiful-mermaid": "^1.1.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.0.0",
    "vite": "^7.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "eslint": "^10.0.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.18"
  }
}
